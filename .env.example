# ==============================================================================
# MIKROTIK IP WHITELIST SERVICE - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Salin file ini menjadi .env atau gunakan pada file konfigurasi systemd / container.
# Contoh: cp .env.example .env
# ==============================================================================

# Alamat bind HTTP server.
# Direkomendasikan menggunakan 127.0.0.1 atau IP internal server agar hanya
# dapat diakses melalui reverse proxy manager (Nginx / Caddy / Cloudflare Tunnel),
# bukan langsung dari internet publik.
LISTEN_ADDR=127.0.0.1:8080

# Alamat IP lokal router MikroTik yang berada dalam satu jaringan LAN.
# WAJIB DIISI (Contoh: 192.168.88.1 atau 10.0.0.1)
MIKROTIK_HOST=192.168.88.1

# Port RouterOS API standar (plaintext).
# Default: 8728
MIKROTIK_PORT=8728

# Kredensial akun pengguna khusus API di RouterOS (lihat mikrotik-setup.rsc).
# WAJIB DIISI
MIKROTIK_USER=wl-service
MIKROTIK_PASSWORD=ganti_dengan_password_rahasia_anda

# Token Bearer KHUSUS untuk endpoint script /v1/whitelist (wl.sh / wl.ps1 / curl).
# Klien wajib menyertakan header 'Authorization: Bearer <AUTH_BEARER_TOKEN>'.
# Kosongkan untuk menonaktifkan /v1/whitelist. Token ini tidak bisa membuka Web UI;
# akses Web UI hanya melalui SSO Authentik.
AUTH_BEARER_TOKEN=ganti_dengan_token_bearer_rahasia_anda

# Nama address-list firewall di MikroTik tempat IP remote akan ditambahkan.
# Default: remote-whitelist
WHITELIST_LIST_NAME=remote-whitelist

# Nama address-list firewall di MikroTik tempat IP terdeteksi melakukan abuse/scan port-forward.
# Jika IP target terdaftar di list ini saat mendaftar whitelist, IP akan dihapus dari
# list ini terlebih dahulu sebelum ditambahkan ke remote-whitelist.
# Default: port-forward-abuse
PORT_FORWARD_ABUSE_LIST_NAME=port-forward-abuse

# Durasi masa berlaku IP sebelum otomatis dihapus oleh router MikroTik.
# Format durasi yang didukung: "8h", "12h", "30m", "1d", dll.
# Default: 8h
WHITELIST_TTL=1d

# Daftar IP publik kantor atau CIDR subnet kantor sendiri (dipisahkan koma).
# IP di daftar ini akan ditolak agar tidak sengaja dimasukkan ke remote-whitelist.
# Contoh: 203.0.113.100,198.51.100.0/24
OFFICE_PUBLIC_IPS=

# Izinkan pendaftaran alamat IPv6 publik (true/false).
# Jika false, hanya IPv4 publik yang diizinkan mendaftar.
# Default: false
ALLOW_IPV6=false

# Zona waktu untuk kalkulasi timestamp kedaluwarsa pada respons dan log.
# Default: Asia/Jakarta
TZ=Asia/Jakarta

# ------------------------------------------------------------------------------
# SSO AUTHENTIK (OpenID Connect) - WAJIB
# ------------------------------------------------------------------------------
# Satu-satunya cara login ke Web UI. AUTHENTIK_ISSUER_URL, AUTHENTIK_CLIENT_ID,
# dan AUTHENTIK_REDIRECT_URL wajib diisi.
# Format issuer: https://<authentik-host>/application/o/<application-slug>/
AUTHENTIK_ISSUER_URL=
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=

# URL callback publik; daftarkan persis sama di Redirect URIs provider Authentik.
AUTHENTIK_REDIRECT_URL=https://wl.example.com/auth/callback

# Scope OIDC (dipisah spasi). Default: openid profile email
AUTHENTIK_SCOPES=openid profile email

# Grup Authentik yang diizinkan masuk (dipisah koma). Kosong = semua user.
AUTHENTIK_ALLOWED_GROUPS=

# Redirect setelah logout dari Authentik (opsional).
AUTHENTIK_POST_LOGOUT_URL=
